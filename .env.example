# Copy this file to .env and fill in your API keys.
# Only the keys for providers you want to use are required.
# The router auto-detects available providers based on which keys are set.

# HuggingFace Inference API token (required for mistralai, gemma, llama models)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Groq API key (required for llama3, mixtral models)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (required for gemini-pro, gemini-flash models)
GEMINI_API_KEY=your_google_gemini_api_key_here
